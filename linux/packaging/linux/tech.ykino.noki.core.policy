<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Noki</vendor>
  <action id="tech.ykino.noki.core">
    <description>Manage the Noki VPN connection</description>
    <message>Authentication is required to manage Noki VPN</message>
    <icon_name>noki</icon_name>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>yes</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/noki/core-helper</annotate>
  </action>
</policyconfig>
